{
  "name": "mgravey.github.io",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "assets": "node scripts/build-assets.js",
    "bundle:js": "esbuild assets/js/app.js --bundle --minify --outfile=assets/dist/site.js",
    "prepare:site": "npm run assets && npm run bundle:js",
    "build": "npm run prepare:site && bundle exec jekyll build --strict_front_matter",
    "serve": "npm run prepare:site && bundle exec jekyll serve --livereload --strict_front_matter",
    "validate": "ruby scripts/validate_content.rb",
    "test:e2e": "playwright test",
    "test": "npm run validate && npm run build && bundle exec htmlproofer ./_site --disable-external --allow-hash-href && npm run test:e2e",
    "publications": "ruby scripts/update_publications.rb"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mgravey/mgravey.github.io.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "private": true,
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/mgravey/mgravey.github.io/issues"
  },
  "homepage": "https://github.com/mgravey/mgravey.github.io#readme",
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "esbuild": "^0.28.1",
    "sharp": "^0.35.3"
  },
  "dependencies": {
    "@barba/core": "^2.10.3"
  }
}
